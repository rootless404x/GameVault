```cshtml
@model GameVault.Models.Contacto

@{
    ViewData["Title"] = "Detalle del mensaje";
}

<div class="container mt-4 mb-5">

    <div class="card shadow">

        <div class="card-header text-white"
             style="background-color: #8b2be2;">

            <h3 class="mb-0">
                📩 Mensaje de contacto
            </h3>

        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>Nombre:</strong>
                <p>@Model.Nombre</p>
            </div>

            <div class="mb-3">
                <strong>Correo electrónico:</strong>
                <p>@Model.Email</p>
            </div>

            <div class="mb-3">
                <strong>Fecha:</strong>
                <p>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div class="mb-4">
                <strong>Mensaje:</strong>

                <div class="border rounded p-3 mt-2">
                    @Model.Mensaje
                </div>
            </div>

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Eliminar
            </a>

        </div>

    </div>

</div>
```