@model IEnumerable<GameVault.Models.Contacto>

@{
    ViewData["Title"] = "Mensajes de Contacto";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                📩 Mensajes de contacto
            </h1>
        </div>

    </div>

    <div class="card shadow">

        <div class="card-header text-white" style="background-color: #8b2be2;">

            <h4 class="mb-0">
                Bandeja de mensajes
            </h4>

        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    No hay mensajes de contacto.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Estado</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var contacto in Model)
                            {
                                <tr>

                                    <td>
                                        @if (contacto.Leido)
                                        {
                                            <span class="badge bg-success">
                                                ✓ Leído
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                🔵 Nuevo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @contacto.Nombre
                                    </td>

                                    <td>
                                        @contacto.Email
                                    </td>

                                    <td>
                                        @contacto.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@contacto.Id"
                                           class="btn btn-primary btn-sm">
                                            Ver
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@contacto.Id"
                                           class="btn btn-danger btn-sm">
                                            Eliminar
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>