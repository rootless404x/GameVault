@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card shadow-lg p-4">

                <div class="card-body">

                    <h1 class="text-center fw-bold mb-4 text-white">
                        GAMEVAULT 🎮
                    </h1>

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger text-center" role="alert">
                            @ViewBag.Mensaje
                        </div>
                    }

                    <form asp-controller="Login"
                          asp-action="Index"
                          method="post"
                          class="border-0 p-0"
                          aria-label="Formulario de inicio de sesión">

                        <div class="mb-3">

                            <label for="correo" class="form-label text-secundario">
                                Correo electrónico
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-dark border-secondary text-white"
                                      aria-hidden="true">
                                    👤
                                </span>

                                <input type="email"
                                       id="correo"
                                       name="correo"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="Ingrese su correo"
                                       autocomplete="email"
                                       required
                                       aria-required="true" />

                            </div>

                        </div>

                        <div class="mb-3">

                            <label for="password" class="form-label text-secundario">
                                Contraseña
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-dark border-secondary text-white"
                                      aria-hidden="true">
                                    🔒
                                </span>

                                <input type="password"
                                       id="password"
                                       name="password"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="Ingrese su contraseña"
                                       autocomplete="current-password"
                                       required
                                       aria-required="true" />

                            </div>

                        </div>

                        <div class="d-grid mt-4">

                            <button type="submit" class="btn btn-primary py-2 fw-bold">
                                Iniciar Sesión
                            </button>

                        </div>

                    </form>

                    <div class="text-center mt-4">

                        <span class="text-secundario">
                            ¿No tienes una cuenta?
                        </span>

                        <a asp-controller="Registro"
                           asp-action="Index"
                           class="text-decoration-none fw-bold"
                           style="color: #b83df2;">
                            Regístrate aquí
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>