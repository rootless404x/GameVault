@{
    ViewData["Title"] = "Reporte de Productos";
}

<div class="container mt-4">
    <h2>Reporte de Productos</h2>
    <hr />

    <!-- Formulario de Filtros -->
    <div class="card p-3 mb-4 shadow-sm">
        <form id="filterForm" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nombre</label>
                <input type="text" id="nombre" class="form-control" placeholder="Buscar por nombre..." />
            </div>
            <div class="col-md-4">
                <label class="form-label">Categoría</label>
                <input type="text" id="categoria" class="form-control" placeholder="Buscar por categoría..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio Máximo</label>
                <input type="number" step="0.01" id="precioMax" class="form-control" placeholder="Ej: 150.00" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="button" onclick="actualizarVistaPrevia()" class="btn btn-primary w-100">
                    Filtrar
                </button>
            </div>
        </form>
    </div>

    <!-- Vista Previa PDF -->
    <div class="card shadow-sm p-2">
        <h5 class="card-title ms-2">Vista Previa del Reporte</h5>
        <iframe id="pdfPreview" style="width: 100%; height: 650px; border: none;"></iframe>
    </div>
</div>

@section Scripts {
    <script>
        function actualizarVistaPrevia() {
            const nombre = document.getElementById('nombre').value;
            const categoria = document.getElementById('categoria').value;
            const precioMax = document.getElementById('precioMax').value;

            const url = `/Reportes/GenerarReportePdf?nombre=${encodeURIComponent(nombre)}&categoria=${encodeURIComponent(categoria)}&precioMax=${encodeURIComponent(precioMax)}`;
            document.getElementById('pdfPreview').src = url;
        }

        // Cargar reporte automáticamente al abrir la página
        window.onload = function() {
            actualizarVistaPrevia();
        };
    </script>
}