@model GameVault.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "GameVault";
}

<section id="inicio" class="hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-12 col-lg-6 text-center text-lg-start">

                <h1 class="display-4 fw-bold">
                    Lleva tu experiencia gaming al siguiente nivel
                </h1>

                <p class="lead my-4">
                    Encuentra audífonos, teclados y mouse para llevar tu
                    experiencia de juego al siguiente nivel.
                </p>

                <a href="#productos"
                   class="btn btn-primary btn-lg">
                    Ver productos
                </a>

            </div>

            <div class="col-12 col-lg-6 text-center mt-4 mt-lg-0">

                <img src="~/img/hero.jpg"
                     alt="Computadora gamer"
                     class="img-fluid rounded shadow" />

            </div>

        </div>
    </div>
</section>


<section id="productos" class="py-5" aria-labelledby="titulo-productos">

    <div class="container">

        <h2 id="titulo-productos"
            class="text-center fw-bold mb-5">
            Nuestros productos
        </h2>

        <div class="row">

            @foreach (var producto in Model.Productos)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h3 class="card-title h5">
                                @producto.Nombre
                            </h3>

                            <p class="card-text">
                                @producto.Descripcion
                            </p>

                            <p>
                                <strong>Categoría:</strong>
                                @producto.Categoria
                            </p>

                            <p>
                                <strong>Precio:</strong>
                                S/ @producto.Precio
                            </p>

                            <p>
                                <strong>Stock:</strong>
                                @producto.Stock
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    </div>

</section>


<section id="contacto"
         class="py-5"
         aria-labelledby="titulo-contacto">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-md-10 col-lg-7">

                <div class="text-center mb-4">

                    <h2 id="titulo-contacto"
                        class="fw-bold">
                        Contáctanos
                    </h2>

                    <p class="text-secundario">
                        ¿Tienes alguna consulta? Escríbenos.
                    </p>

                </div>

                <form asp-controller="Home"
                      asp-action="Contacto"
                      method="post"
                      novalidate
                      aria-label="Formulario de contacto">

                    <div class="mb-3">

                        <label asp-for="Contacto.Nombre"
                               class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Contacto.Nombre"
                               class="form-control"
                               placeholder="Ingrese su nombre"
                               aria-required="true" />

                        <span asp-validation-for="Contacto.Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Contacto.Email"
                               class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Contacto.Email"
                               class="form-control"
                               placeholder="ejemplo@correo.com"
                               aria-required="true" />

                        <span asp-validation-for="Contacto.Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Contacto.Mensaje"
                               class="form-label">
                            Mensaje
                        </label>

                        <textarea asp-for="Contacto.Mensaje"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Escriba su mensaje"
                                  aria-required="true"></textarea>

                        <span asp-validation-for="Contacto.Mensaje"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="text-center">

                        <button type="submit"
                                class="btn btn-primary">
                            Enviar mensaje
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            if (document.querySelector(".field-validation-error")) {
                document.getElementById("contacto").scrollIntoView();
            }

        });
    </script>
}