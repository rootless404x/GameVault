@model GameVault.Models.Producto

@{
    ViewData["Title"] = "Agregar Producto";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow">

                <div class="card-header text-white"
                     style="background-color: #8b2be2;">

                    <h1 class="h3 mb-0">
                        Agregar Nuevo Producto 🎮
                    </h1>

                </div>

                <div class="card-body">

                    <form asp-controller="Productos"
                          asp-action="Create"
                          method="post"
                          novalidate
                          aria-label="Formulario para agregar producto">

                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label">
                                Nombre del producto
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   aria-required="true"
                                   placeholder="Ingrese el nombre del producto" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Precio"
                                   class="form-label">
                                Precio
                            </label>

                            <input asp-for="Precio"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   aria-required="true"
                                   placeholder="Ej. 59.90" />

                            <span asp-validation-for="Precio"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Stock"
                                   class="form-label">
                                Stock
                            </label>

                            <input asp-for="Stock"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   aria-required="true"
                                   placeholder="Cantidad disponible" />

                            <span asp-validation-for="Stock"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Categoria"
                                   class="form-label">
                                Categoría
                            </label>

                            <input asp-for="Categoria"
                                   class="form-control"
                                   aria-required="true"
                                   placeholder="Ej. Computadora, Teclado..." />

                            <span asp-validation-for="Categoria"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Descripcion"
                                   class="form-label">
                                Descripción
                            </label>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ingrese una descripción del producto"></textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar Producto
                            </button>

                            <a asp-controller="Productos"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Volver
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}