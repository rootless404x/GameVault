@model GameVault.Models.Producto

<div class="container mt-5 mb-5">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Eliminar Producto 🎮</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Advertencia:</strong>
                ¿Está seguro de que desea eliminar este producto?
            </div>

            <p>
                <strong>Nombre:</strong> @Model.Nombre
            </p>

            <p>
                <strong>Precio:</strong> S/ @Model.Precio
            </p>

            <p>
                <strong>Stock:</strong> @Model.Stock
            </p>

            <p>
                <strong>Categoría:</strong> @Model.Categoria
            </p>

            <p>
                <strong>Descripción:</strong> @Model.Descripcion
            </p>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Sí, eliminar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>