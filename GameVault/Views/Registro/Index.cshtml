@model GameVault.Models.Usuario
@{
    Layout = null;
}
@{
    ViewData["Title"] = "Registro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameVault</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <img src="~/img/icono.png" alt="Logo de Game Vault" style="width: 50px; height: 50px; object-fit: contain; margin-right: 10px;" />
                GameVault
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacion"
                    aria-controls="menuNavegacion" aria-expanded="false" aria-label="Mostrar menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavegacion">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm px-3 mt-1" asp-controller="Home" asp-action="Index">
                            ⬅ Volver al Inicio
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                
                <div class="card shadow-lg p-4">
                    <div class="card-body">
                        
                        <h2 class="text-center fw-bold mb-4 text-white">REGISTRO 🎮</h2>

                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <form asp-controller="Registro" asp-action="Index" method="post" class="border-0 p-0">

                            <div class="mb-3">
                                <label class="form-label text-secundario">Nombre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-white">👤</span>
                                    <input asp-for="Nombre" 
                                           class="form-control bg-dark text-white border-secondary" 
                                           placeholder="Ingrese su nombre" 
                                           required />
                                </div>
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-secundario">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-white">✉️</span>
                                    <input asp-for="Correo" 
                                           type="email"
                                           class="form-control bg-dark text-white border-secondary" 
                                           placeholder="Ingrese su correo" 
                                           required />
                                </div>
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-secundario">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-white">🔒</span>
                                    <input asp-for="Password" 
                                           type="password"
                                           class="form-control bg-dark text-white border-secondary" 
                                           placeholder="Ingrese su contraseña" 
                                           required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary py-2 fw-bold">
                                    Registrarse
                                </button>
                            </div>

                        </form>

                        <div class="text-center mt-4">
                            <span class="text-secundario">¿Ya tienes una cuenta?</span>
                            <a asp-controller="Login" asp-action="Index" class="text-decoration-none fw-bold" style="color: #b83df2;">
                                Inicia sesión
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>