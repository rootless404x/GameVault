@model GameVault.Models.Usuario

@{
    ViewData["Title"] = "Registro";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card shadow-lg p-4">

                <div class="card-body">

                    <h1 class="text-center fw-bold mb-4 text-white">
                        REGISTRO 🎮
                    </h1>

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger text-center" role="alert">
                            @ViewBag.Mensaje
                        </div>
                    }

                    <form asp-controller="Registro"
                          asp-action="Index"
                          method="post"
                          class="border-0 p-0"
                          aria-label="Formulario de registro">

                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label text-secundario">
                                Nombre
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-dark border-secondary text-white"
                                      aria-hidden="true">
                                    👤
                                </span>

                                <input asp-for="Nombre"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="Ingrese su nombre"
                                       autocomplete="name"
                                       required
                                       aria-required="true" />

                            </div>

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Correo"
                                   class="form-label text-secundario">
                                Correo electrónico
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-dark border-secondary text-white"
                                      aria-hidden="true">
                                    ✉️
                                </span>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="Ingrese su correo"
                                       autocomplete="email"
                                       required
                                       aria-required="true" />

                            </div>

                            <span asp-validation-for="Correo"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label text-secundario">
                                Contraseña
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-dark border-secondary text-white"
                                      aria-hidden="true">
                                    🔒
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control bg-dark text-white border-secondary"
                                       placeholder="Ingrese su contraseña"
                                       autocomplete="new-password"
                                       required
                                       aria-required="true" />

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-primary py-2 fw-bold">
                                Registrarse
                            </button>

                        </div>

                    </form>


                    <div class="text-center mt-4">

                        <span class="text-secundario">
                            ¿Ya tienes una cuenta?
                        </span>

                        <a asp-controller="Login"
                           asp-action="Index"
                           class="text-decoration-none fw-bold"
                           style="color: #b83df2;">
                            Inicia sesión
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>